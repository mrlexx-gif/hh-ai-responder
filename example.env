# Ссылка на поиск вакансий
HH_SEARCH_URL=https://hh.ru/search/vacancy?text=python

# ID резюме (если не указан — используется последнее)
HH_RESUME=

# OpenAI-compatible API
HH_AI_BASE_URL=http://localhost:11434
HH_AI_MODEL=llama3.1:8b
HH_AI_API_KEY=

# Каталог с *.md файлами контекста и переопределений промптов
# (chat.md, chat_user.md, letter.md, solution.md, а также любые другие *.md
# с доп. контекстом)
HH_PROMPTS_DIR=prompts

# Интервал опроса чатов на новые сообщения работодателя.
# Приложение отвечает на новые сообщения (в т.ч. автоответы на наши
# сообщения) в цикле, пока вы не закроете его. Например: 30s, 1m, 5m.
HH_CHAT_INTERVAL=1m
